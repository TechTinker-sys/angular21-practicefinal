{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "isolatedModules": false,
    "noEmit": true
  },
  "include": ["src/api/**/*.ts", "tests/**/*.ts"]
}